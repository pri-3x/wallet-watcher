# Postgres from docker compose. The published port is 5436 so it can sit beside another local Postgres.
# Set USE_DATABASE=false to keep watches in data/store.json instead.
DATABASE_URL=postgresql://wallet:wallet@localhost:5436/walletwatch
USE_DATABASE=true

# When set, only one worker polls at a time. If Redis cannot be reached, that pass is skipped.
REDIS_URL=redis://localhost:6379
# How often the worker re-reads watched wallets. Minimum 10000.
POLL_INTERVAL_MS=30000

SESSION_SECRET=replace-with-a-long-random-string
WORKER_SECRET=replace-with-a-long-random-string

# Default chain when a link does not name one. mainnet reads Ethereum. sepolia reads the testnet.
# ETHEREUM_RPC_URL is used only for that default. Other chains use a public RPC unless overridden.
ETHEREUM_NETWORK=mainnet
ETHEREUM_RPC_URL=
ETHERSCAN_API_KEY=
POLYGON_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
SOLANA_RPC_URL=
ETH_USD=

# Razorpay. Test keys start with rzp_test_. The secret never leaves the server.
# Paid desks: Desk ₹4,900 and Terminal ₹14,900, each for 30 days. Standard Checkout does not auto-renew.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Stripe. Leave STRIPE_SECRET_KEY empty and Razorpay is used when its keys are set.
# Create two recurring prices in the Stripe dashboard and paste their ids.
# The webhook endpoint is POST /api/billing/webhook. Locally: stripe listen --forward-to localhost:3001/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DESK=
STRIPE_PRICE_TERMINAL=
# Where Stripe sends people back after checkout. Defaults to the request origin.
APP_URL=

# Notification providers. Missing keys are logged, not invented.
# Without EMAIL_FROM, email uses Resend's test sender, which only reaches your own Resend account address.
RESEND_API_KEY=
EMAIL_FROM=
# From @BotFather. Message the bot once, then Settings can find the chat.
TELEGRAM_BOT_TOKEN=
ENABLE_ENS=false
