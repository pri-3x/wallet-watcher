# Postgres. The app uses a local file store until USE_DATABASE=true.
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/walletwatch
USE_DATABASE=false

# Optional. The worker uses Redis as a lock when more than one process polls.
REDIS_URL=redis://localhost:6379
# How often the worker re-reads watched wallets. Minimum 10000.
POLL_INTERVAL_MS=30000

SESSION_SECRET=replace-with-a-long-random-string
WORKER_SECRET=replace-with-a-long-random-string

# Ethereum. mainnet, or sepolia for testnet reads.
# Sepolia uses a public RPC and Blockscout when the RPC URL and API key are empty.
ETHEREUM_NETWORK=mainnet
ETHEREUM_RPC_URL=
ETHERSCAN_API_KEY=
ETH_USD=

# Notification providers. Missing keys are logged, not invented.
RESEND_API_KEY=
EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
ENABLE_ENS=false
